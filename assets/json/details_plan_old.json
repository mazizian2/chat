  },
  "speed": {
    "type": "integer|null",
    "unit": "Mbps",
    "range": [1, 8]},
  "download": {
    "type": "integer|null",
    "unit": "Mbps",
    "range": [16, 70]
  },
  "upload": {
    "type": "integer|null",
    "unit": "Mbps",
    "range": [2, 25]
  },
