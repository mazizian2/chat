  },
  "ram": {
    "type": "string|null",
    "example": "2 GB"
  },
  "storage": {
    "type": "string|null",
    "example": "25 GB SSD"
  },
  "traffic_internal": {
    "type": "string|null",
    "example": "1000 GB"
  },
  "traffic_international": {
    "type": "string|null",
    "example": "100 GB"
  },
  "service_type": {
    "type": "string|null",
