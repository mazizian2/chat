    "type": "integer",
    "unit": "تومان",
    "range": [480000, 15000000]
  },
  "regular_price": {
    "type": "integer|null",
    "unit": "تومان",
    "range": [1000000, 28000000]
  },
  "duration": {
    "type": "integer",
    "unit": "روز",
    "range": [30, 365]
  },
  "cpu": {
    "type": "string|null",
